# ── SUPABASE ───────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key (NO la anon)

# ── GOOGLE (una sola cuenta de servicio para todo) ─────────────
# Crear en: console.cloud.google.com → IAM → Service Accounts
# Habilitar: Google Sheets API, GA4 Data API, Content API for Shopping
# Compartir el Sheet de Mike Rhodes con el email de la cuenta de servicio
GOOGLE_CREDENTIALS_PATH=/tmp/google_credentials.json

# ── GOOGLE SHEETS (Mike Rhodes + smec) ────────────────────────
# El ID está en la URL: /spreadsheets/d/[SHEET_ID]/edit
MIKE_RHODES_SHEET_ID=1amLSV3aXX2Ih2ItMb32Z3mwkzkdLctqUXa7SDB2KiyI
SMEC_SHEET_ID=1yHj9CilZbgGshPFyVZkvjAr9nNtQPQvYfvC8IYJ9nGc

# ── META ADS ───────────────────────────────────────────────────
# Token: developers.facebook.com → Graph API Explorer → long-lived token
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# ID de cuenta: Meta Ads Manager → URL act_XXXXXXXXX
META_AD_ACCOUNT_ID=XXXXXXXXXX

# ── GOOGLE ANALYTICS 4 ────────────────────────────────────────
# Property ID: GA4 → Admin → Property Settings → Property ID
GA4_PROPERTY_ID=XXXXXXXXX

# ── GOOGLE MERCHANT CENTER ────────────────────────────────────
# Merchant ID: Merchant Center → Settings → Account information
GMC_MERCHANT_ID=XXXXXXXXXX

# ── SHOPIFY ───────────────────────────────────────────────────
# URL: mi-tienda.myshopify.com (sin https://)
SHOPIFY_SHOP_URL=mi-tienda.myshopify.com
# Token: Shopify Admin → Apps → Custom apps → crear app con permisos read_orders, read_products
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MICROSOFT CLARITY ─────────────────────────────────────────
# Clarity no tiene API pública — exportar CSV manualmente desde el panel
# o subir el CSV al repo y referenciarlo aquí
CLARITY_CSV_PATH=/tmp/clarity_export.csv

# ── ETL ───────────────────────────────────────────────────────
# UUID del cliente en Supabase (tabla clients)
DEFAULT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
